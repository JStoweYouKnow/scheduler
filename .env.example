# App
APP_URL=http://localhost:3000
SCHEDULER_ADMIN_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Postgres / Supabase
DATABASE_URL=

# Model — prefer Vercel AI Gateway (OIDC on Vercel, or AI_GATEWAY_API_KEY locally)
AI_GATEWAY_API_KEY=
# Optional fallback if you are not using the gateway yet
ANTHROPIC_API_KEY=

# Google Calendar + Gmail OAuth (per teammate)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Optional Workspace domain-wide delegation
GOOGLE_DELEGATION_SUBJECT=

# Shared inbox label (overrides config/team.yaml)
GMAIL_LABEL=scheduling

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#scheduling
