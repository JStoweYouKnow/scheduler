# App
APP_URL=http://localhost:3000
SCHEDULER_ADMIN_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Postgres / Supabase (optional when DEMO_MODE=1)
DATABASE_URL=

# Nebius Token Factory (required)
NEBIUS_API_KEY=
# Defaults match the public catalog — override if the console IDs differ.
MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Judge mode: in-memory calendar + Gmail, seeded fiction. Only NEBIUS_API_KEY is required.
DEMO_MODE=

# Google Calendar + Gmail + Drive OAuth (per teammate). Skipped in DEMO_MODE.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_DELEGATION_SUBJECT=

# Shared inbox label (overrides config/team.yaml)
GMAIL_LABEL=scheduling

# Slack (optional)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=#scheduling

# Same keys as Dailie / Interface / Bench (do not create a new Clerk app). Skipped in DEMO_MODE.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
